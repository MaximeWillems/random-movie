# En-têtes servis par Cloudflare Pages

# Sécurité : seules les sources réellement utilisées sont permises
# (polices Google, API et images TMDB, recherche Internet Archive)
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://image.tmdb.org; connect-src 'self' https://api.themoviedb.org https://archive.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Données et images : gardées en cache, elles changent rarement
/*.json
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=604800
/og.jpg
  Cache-Control: public, max-age=604800
